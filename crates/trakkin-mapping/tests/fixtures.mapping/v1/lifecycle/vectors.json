{
  "schema": "fixtures.mapping/v1",
  "hashes": {
    "h1": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "h2": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "h3": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
  },
  "vectors": [
    {
      "id": "LIFECYCLE-CREATE-001",
      "request": {
        "schema": "trakkin.mapping/v1",
        "mappings": [["catalog.example://title/primary", "metadata.example://movie/secondary"]]
      },
      "expected": { "serverGeneratesMappingId": true, "revision": 1, "parents": [], "activated": false },
      "portableBody": {
        "schema": "trakkin.mapping/v1",
        "revision": 1,
        "mappings": [["catalog.example://title/primary", "metadata.example://movie/secondary"]]
      },
      "covers": ["lifecycle.create", "portability.no-local-identity", "ui.authoring-history-diff"]
    },
    {
      "id": "LIFECYCLE-UPDATE-001",
      "setup": { "head": "$h1", "revision": 1 },
      "action": {
        "baseContentHash": "$h1",
        "replaceMappingsWith": [
          ["catalog.example://title/primary", "metadata.example://movie/secondary"],
          ["example.media://a", "example.media://b"]
        ]
      },
      "expected": { "revision": 2, "parents": ["$h1"], "head": "$h2", "previousImmutable": true },
      "covers": ["lifecycle.immutable-update", "lifecycle.parent"]
    },
    {
      "id": "LIFECYCLE-STALE-BASE-001",
      "setup": { "head": "$h2", "revision": 2 },
      "action": { "baseContentHash": "$h1" },
      "expected": {
        "httpStatus": 409,
        "code": "head_moved",
        "currentHead": "$h2",
        "canonicalRowSetDiff": true,
        "writes": 0
      },
      "covers": ["lifecycle.stale-base", "diagnostic.head-moved"]
    },
    {
      "id": "LIFECYCLE-EXACT-DUPLICATE-001",
      "setup": { "storedContentHash": "$h1" },
      "action": { "importContentHash": "$h1" },
      "expected": { "immutableContentReused": true, "newContentRows": 0 },
      "covers": ["lifecycle.exact-duplicate"]
    },
    {
      "id": "LIFECYCLE-SEMANTIC-DUPLICATE-001",
      "setup": { "revision": 1, "contentHash": "$h1", "semanticFingerprint": "semantic:aaaaaaaa" },
      "action": { "importRevision": 9, "contentHash": "$h2", "semanticFingerprint": "semantic:aaaaaaaa" },
      "expected": { "distinctHistory": true, "rowsEvaluatedOnce": true, "provenanceHashes": ["$h1", "$h2"] },
      "covers": ["lifecycle.semantic-duplicate"]
    },
    {
      "id": "LIFECYCLE-IMPORT-001",
      "action": {
        "portableBody": {
          "schema": "trakkin.mapping/v1",
          "revision": 7,
          "mappings": [["catalog.example://title/primary", "metadata.example://movie/secondary"]]
        },
        "contentHash": "sha256:feeaaea25a1a0afe08ed021e0c5396691f9117336dc0ee5e3998f0149f15ac55",
        "parents": []
      },
      "expected": {
        "newLocalMappingId": true,
        "revision": 7,
        "lineageRoot": "sha256:feeaaea25a1a0afe08ed021e0c5396691f9117336dc0ee5e3998f0149f15ac55",
        "activated": false,
        "canonicalRoundTrip": true
      },
      "covers": ["lifecycle.import", "portability.server-owned-id"]
    },
    {
      "id": "LIFECYCLE-INCOMPLETE-ANCESTRY-001",
      "action": { "importRevision": 7, "contentHash": "$h2", "parents": ["$h1"] },
      "expected": { "accepted": true, "externalParents": [{ "hash": "$h1", "verified": false }] },
      "covers": ["lifecycle.incomplete-ancestry"]
    },
    {
      "id": "LIFECYCLE-FORK-001",
      "setup": { "localHead": "$h3", "selectedNonHead": "$h1" },
      "action": { "editSelectedRevision": true },
      "expected": { "newLocalMappingId": true, "externalParents": ["$h1"], "originalHead": "$h3" },
      "covers": ["lifecycle.fork"]
    },
    {
      "id": "LIFECYCLE-SELF-PARENT-001",
      "action": { "contentHash": "$h1", "parents": ["$h1"] },
      "expected": { "accepted": false, "code": "lineage_cycle" },
      "covers": ["lifecycle.self-parent", "diagnostic.lineage-cycle"]
    },
    {
      "id": "LIFECYCLE-MULTI-NODE-CYCLE-001",
      "action": {
        "nodes": [
          { "hash": "$h1", "parents": ["$h2"] },
          { "hash": "$h2", "parents": ["$h3"] },
          { "hash": "$h3", "parents": ["$h1"] }
        ]
      },
      "expected": { "accepted": false, "code": "lineage_cycle", "cycle": ["$h1", "$h2", "$h3", "$h1"] },
      "covers": ["lifecycle.multi-node-cycle", "diagnostic.lineage-cycle"]
    },
    {
      "id": "LIFECYCLE-ACTIVATION-ROLLBACK-RETIREMENT-001",
      "setup": { "workspace": "workspace.local-a", "revisions": ["$h1", "$h2"] },
      "actions": [{ "activate": "$h2" }, { "rollback": "$h1" }, { "retire": true }],
      "expected": {
        "activationPointers": ["$h2", "$h1", null],
        "auditEvents": 3,
        "portableRevisionsMutated": false,
        "precedenceCreated": false
      },
      "covers": [
        "lifecycle.activation",
        "lifecycle.rollback",
        "lifecycle.retirement",
        "portability.local-activation",
        "ui.activation-rollback-retirement"
      ]
    },
    {
      "id": "PACKAGE-MANIFEST-VALID-001",
      "action": {
        "documentFixtures": [
          {
            "path": "mappings/signal.json",
            "portableBody": {
              "schema": "trakkin.mapping/v1",
              "revision": 1,
              "mappings": [
                ["example.media://double-length[episode:1..*2]", "example.media://weekly[episode:1..]"],
                ["catalog.example://title/primary", "metadata.example://movie/secondary"]
              ]
            },
            "expectedHash": "sha256:d422dcfd15bb7bdef4f5e0b6a97f5e0ab52004ac28376515fdc3fe4e7b9e7309"
          }
        ],
        "manifest": {
          "schema": "trakkin.mapping-package/v1",
          "documents": [
            {
              "path": "mappings/signal.json",
              "hash": "sha256:d422dcfd15bb7bdef4f5e0b6a97f5e0ab52004ac28376515fdc3fe4e7b9e7309"
            }
          ],
          "roots": ["$h1"],
          "parents": { "sha256:d422dcfd15bb7bdef4f5e0b6a97f5e0ab52004ac28376515fdc3fe4e7b9e7309": ["$h1"] },
          "licenseExpression": "MIT",
          "attribution": [{ "name": "Example Mapping Authors" }],
          "signatures": [
            { "kind": "sigstore", "digest": "sha256:d422dcfd15bb7bdef4f5e0b6a97f5e0ab52004ac28376515fdc3fe4e7b9e7309" }
          ],
          "forge": { "commit": "0123456789abcdef" },
          "requires": {
            "mappingSchema": "trakkin.mapping/v1",
            "resolver": ">=1.0 <2.0",
            "coordinateRegistryDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        }
      },
      "expected": {
        "accepted": true,
        "changesSemanticHash": false,
        "verifiedDocumentHashes": ["sha256:d422dcfd15bb7bdef4f5e0b6a97f5e0ab52004ac28376515fdc3fe4e7b9e7309"]
      },
      "covers": [
        "package.license",
        "package.attribution",
        "package.compatibility",
        "package.provenance",
        "package.signature"
      ]
    },
    {
      "id": "PACKAGE-COMPATIBILITY-REJECT-001",
      "action": {
        "requires": {
          "mappingSchema": "trakkin.mapping/v2",
          "resolver": ">=2.0",
          "coordinateRegistryDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      },
      "expected": {
        "accepted": false,
        "code": "package_incompatible",
        "reasons": ["mapping_schema", "resolver", "coordinate_registry"]
      },
      "covers": ["package.compatibility", "diagnostic.package-incompatible"]
    }
  ]
}
